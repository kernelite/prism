      "operation": "Hardware Reset",
      "source_function": "vm_reset",
      "description": "Reset the device"
    },
    {
      "step": 3,
      "operation": "Write Register",
      "source_function": "readl",
      "target_register": "VIRTIO_MMIO_MAGIC_VALUE",
      "offset": "0x0",
      "value_or_mask": "0x00000000",
      "description": "Read the magic value"
    },
    {
      "step": 4,
      "operation": "Read & Poll",
      "source_function": "readl",
      "target_register": "VIRTIO_MMIO_MAGIC_VALUE",
      "offset": "0x0",
      "value_or_mask": "0x00000000",
      "poll_condition": "magic != ('v' | 'i' << 8 | 'r' << 16 | 't' << 24)",
      "description": "Poll for correct magic value"
    },
    {
      "step": 5,
      "operation": "Read Register",
      "source_function": "readl",
      "target_register": "VIRTIO_MMIO_VERSION",
      "offset": "0x4",
      "description": "Read the device version"
    },
    {
      "step": 6,
      "operation": "Read & Poll",
      "source_function": "readl",
      "target_register": "VIRTIO_MMIO_VERSION",
      "offset": "0x4",
      "poll_condition": "vm_dev->version < 1 || vm_dev->version > 3",
      "description": "Poll for correct device version"
    },
    {
      "step": 7,
      "operation": "Read Register",
      "source_function": "readl",
      "target_register": "VIRTIO_MMIO_DEVICE_ID",
      "offset": "0xc",
      "description": "Read the device ID"
    },
    {
      "step": 8,
      "operation": "Read & Poll",
      "source_function": "readl",
      "target_register": "VIRTIO_MMIO_DEVICE_ID",
      "offset": "0xc",
      "value_or_mask": "vm_dev->vdev.id.device == 0",
      "poll_condition": "vm_dev->vdev.id.device == 0",
      "description": "Check for dummy device"
    },
    {
      "step": 9,
      "operation": "Read Register",
      "source_function": "readl",
      "target_register": "VIRTIO_MMIO_VENDOR_ID",
      "offset": "0x8",
      "description": "Read the vendor ID"
    },
    {
      "step": 10,
      "operation": "Write Register",
      "source_function": "writel",
      "target_register": "VIRTIO_MMIO_GUEST_PAGE_SIZE",
      "offset": "0x0",
      "value_or_mask": "PAGE_SIZE",
      "description": "Set guest page size"
    },
    {
      "step": 11,
      "operation": "DMA Setup",
      "source_function": "dma_set_mask_and_coherent",
      "description": "Set DMA mask and coherent mask"
    },
    {
      "step": 12,
